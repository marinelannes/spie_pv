# Copier en .env pour le développement local (chargé automatiquement hors production).

# Base de données : PostgreSQL (docker compose up -d) ou PGlite embarqué (aucune installation).
# DATABASE_URL=postgres://spie:spie@localhost:5432/spiepv
DATABASE_URL=pglite://.data/pglite

# Clé de signature des jetons d'accès (≥ 32 caractères). En Azure : secret Key Vault « jwt-secret ».
JWT_SECRET=dev-uniquement-changer-cette-cle-0123456789

# Premier administrateur, créé au démarrage si la base ne contient aucun compte.
# Le mot de passe est provisoire : il devra être changé à la première connexion.
BOOTSTRAP_ADMIN_EMAIL=admin@spie.local
BOOTSTRAP_ADMIN_NAME=Administrateur
BOOTSTRAP_ADMIN_PASSWORD=ChangerMoi-2026!

# SharePoint : "fake" (dossier local .data/sharepoint), "graph" (Microsoft Graph) ou "disabled".
SHAREPOINT_MODE=fake
# Pour SHAREPOINT_MODE=graph :
# GRAPH_TENANT_ID=<tenant id SPIE>
# GRAPH_CLIENT_ID=<client id de l'app registration>
# GRAPH_CERT_PATH=<chemin du PEM clé privée + certificat>   (ou GRAPH_CERT_PEM=<contenu PEM>)
# SHAREPOINT_SITE_ID=<host,site-guid,web-guid>
